{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dragon oh-my-posh Theme Schema",
  "description": "Validation schema for the Dragon oh-my-posh theme using the blocks-based configuration format.",
  "type": "object",
  "required": ["$schema", "version", "blocks"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to the upstream oh-my-posh schema",
      "pattern": "https://raw\\.githubusercontent\\.com/JanDeDobbeleer/oh-my-posh/main/themes/schema\\.json"
    },
    "version": {
      "type": "integer",
      "description": "oh-my-posh configuration schema version",
      "enum": [3]
    },
    "console_title_template": {
      "type": "string",
      "description": "Template for the console title"
    },
    "final_space": {
      "type": "boolean",
      "description": "Add a trailing space after the prompt"
    },
    "secondary_prompt": { "$ref": "#/definitions/promptTemplate" },
    "transient_prompt": { "$ref": "#/definitions/promptTemplate" },
    "blocks": {
      "type": "array",
      "description": "Prompt blocks rendered by oh-my-posh",
      "minItems": 1,
      "items": { "$ref": "#/definitions/block" }
    },
    "tooltips": {
      "type": "array",
      "description": "Tooltip definitions for segment shortcuts",
      "items": {
        "type": "object",
        "required": ["type", "template"],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$",
            "description": "Segment type receiving the tooltip"
          },
          "style": {
            "type": "string",
            "enum": ["plain", "powerline", "diamond", "accordion"],
            "description": "Tooltip rendering style"
          },
          "template": {
            "type": "string",
            "description": "Tooltip text template"
          },
          "foreground": { "$ref": "#/definitions/colorValue" },
          "background": { "$ref": "#/definitions/colorValue" },
          "tips": {
            "type": "array",
            "description": "Shortcut keys for the tooltip",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "colorValue": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$|^transparent$"
    },
    "promptTemplate": {
      "type": "object",
      "required": ["template"],
      "properties": {
        "template": {
          "type": "string",
          "description": "Text rendered for the prompt"
        },
        "foreground": { "$ref": "#/definitions/colorValue" },
        "background": { "$ref": "#/definitions/colorValue" }
      },
      "additionalProperties": true
    },
    "block": {
      "type": "object",
      "required": ["type", "segments"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["prompt", "rprompt", "secondary_prompt"],
          "description": "Block output location"
        },
        "alignment": {
          "type": "string",
          "enum": ["left", "right", "center"],
          "description": "Alignment for prompt blocks"
        },
        "newline": {
          "type": "boolean",
          "description": "Insert a newline before rendering the block"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/segment" }
        }
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Segment type identifier",
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "style": {
          "type": "string",
          "enum": ["plain", "diamond", "powerline", "accordion"],
          "description": "Rendering style for the segment"
        },
        "template": {
          "type": "string",
          "description": "Template used to render the segment"
        },
        "foreground": { "$ref": "#/definitions/colorValue" },
        "background": { "$ref": "#/definitions/colorValue" },
        "leading_diamond": {
          "type": "string",
          "description": "Custom leading diamond character(s)"
        },
        "trailing_diamond": {
          "type": "string",
          "description": "Custom trailing diamond character(s)"
        },
        "foreground_templates": {
          "type": "array",
          "description": "Conditional foreground overrides",
          "items": { "type": "string" }
        },
        "background_templates": {
          "type": "array",
          "description": "Conditional background overrides",
          "items": { "type": "string" }
        },
        "properties": {
          "type": "object",
          "description": "Segment-specific configuration",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
