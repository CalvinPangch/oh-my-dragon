{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "🐉 {{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FF4500",
          "template": "🐉"
        },
        {
          "type": "session",
          "style": "diamond",
          "foreground": "#FFD700",
          "background": "#8B0000",
          "leading_diamond": "╭─",
          "trailing_diamond": "",
          "template": " {{ if .SSHSession }}  {{ end }}{{ .UserName }}@{{ .HostName }} ",
          "properties": {
            "display_host": true
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "foreground": "#000000",
          "background": "#FF6347",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "full",
            "folder_icon": "📁",
            "home_icon": "🏰"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "#FFD700",
          "background": "#4B0082",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} 🔥 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} ✨ {{ .Staging.String }}{{ end }} ",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "#000000",
          "background": "#FFD700",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "  {{ .Full }} ",
          "properties": {
            "display_mode": "context",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "foreground": "#000000",
          "background": "#32CD32",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "  {{ .Full }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "#FFD700",
          "background": "#8B4513",
          "leading_diamond": "",
          "trailing_diamond": "─╮",
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#8B0000",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#FF4500",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#DC143C{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }}💀{{ else }}🔥{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#FF8C00",
          "template": "⏱️ {{ .FormattedMs }} ",
          "properties": {
            "threshold": 500,
            "style": "austin"
          }
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "#FFD700",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#32CD32{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FF4500{{end}}",
            "{{if eq \"Full\" .State.String}}#00FF00{{end}}"
          ],
          "template": "{{ if not .Error }}{{ .Icon }} {{ .Percentage }}{{ end }} ",
          "properties": {
            "discharging_icon": "🐲",
            "charging_icon": "⚡",
            "charged_icon": "💎"
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#FF4500",
    "template": "🐉 🔥 "
  },
  "secondary_prompt": {
    "foreground": "#8B0000",
    "template": "╰─🔥 "
  },
  "tooltips": [
    {
      "type": "git",
      "tips": ["git", "g"],
      "style": "diamond",
      "foreground": "#FFD700",
      "background": "#8B0000",
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": " 🐉 {{ .HEAD }} ",
      "properties": {
        "fetch_status": false
      }
    }
  ]
}
