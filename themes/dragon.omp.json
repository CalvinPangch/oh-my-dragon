{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "secondary_prompt": {
    "template": "\u2570\u2500\ud83d\udd25 ",
    "foreground": "#8B0000"
  },
  "transient_prompt": {
    "template": "\ud83d\udc32 \ud83d\udd25 ",
    "foreground": "#FF6E3A"
  },
  "console_title_template": "\ud83d\udc32 {{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\ud83d\udc32 ",
          "foreground": "#FF6E3A",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_host": true
          },
          "template": " {{ if .SSHSession }}\ud83d\udd12 {{ end }}\ud83d\udc64 {{ .UserName }}@{{ .HostName }} ",
          "foreground": "#FFD700",
          "background": "#8B0000",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "session",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "\ud83d\udcc1",
            "home_icon": "\ud83c\udff0 ",
            "style": "full"
          },
          "template": "  {{ .Path }} ",
          "foreground": "#1A1A1A",
          "background": "#FF8266",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "\uF126",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \ud83d\udd25 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \u2728 {{ .Staging.String }}{{ end }} ",
          "foreground": "#FFD700",
          "background": "#8A2BE2",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "git",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "display_virtual_env": true,
            "fetch_virtual_env": true,
            "fetch_version": true
          },
          "template": "  \ud83d\udc0d {{ .Full }}{{ if (env \"POETRY_ACTIVE\") }} \ud83e\udeb6{{ end }}{{ if (env \"PIPENV_ACTIVE\") }} \ud83d\udce6{{ end }} ",
          "foreground": "#1A1A1A",
          "background": "#FFD700",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "python",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  \u2b22 {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#66FF66",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "node",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  \ud83d\udce6 {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#FFB347",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "npm",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  \ud83d\udd2c {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#B19CD9",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "dotnet",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  \ud83d\udc39 {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#98FB98",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "go",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  \u2615 {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#F4A460",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "java",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "display_default": false,
            "display_profile": true,
            "display_region": true
          },
          "template": "{{ if or .Profile .User .Role }}  \u2601\ufe0f IAM {{ if .Profile }}{{ .Profile }}{{ else if .User }}{{ .User }}{{ else if .Role }}{{ .Role }}{{ end }}{{ if .Region }} ({{ .Region }}){{ end }} {{ end }}",
          "foreground": "#1A1A1A",
          "background": "#FFD700",
          "leading_powerline_symbol": "\uE0B6",
          "powerline_symbol": "\uE0B4",
          "type": "aws",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "shell": "sh",
            "command": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git status --porcelain themes/dragon.omp.json themes/docs specs/001-dragon-theme | head -n 1; fi"
          },
          "template": "{{ if .Output }} \ud83e\uddea validate {{ end }}",
          "foreground": "#FF6E3A",
          "type": "command",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "austin",
            "threshold": 500
          },
          "template": " \u23f1\ufe0f {{ .FormattedMs }} ",
          "foreground": "#FFAB40",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "precision": 1
          },
          "template": " \ud83d\udc0f RAM {{ printf \"%.1f\" (divf (float64 (sub .Data.PhysicalTotalMemory .Data.PhysicalAvailableMemory)) 1073741824.0) }} / {{ printf \"%.1f\" (divf (float64 .Data.PhysicalTotalMemory) 1073741824.0) }} GB ({{ printf \"%.0f\" (round .Data.PhysicalPercentUsed .Data.Precision) }}%) ",
          "foreground": "#FF6E3A",
          "type": "sysinfo",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \u23f0 {{ .CurrentDate | date \"15:04:05\" }} \ud83d\uddfc {{ dateInZone \"MST 15:04:05\" .CurrentDate \"Europe/Berlin\" }} ",
          "foreground": "#FFD700",
          "type": "time",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_default": false
          },
          "template": "{{ if .Name }} \ud83c\udf0d {{ .Name }}{{ if .Subscription }} ({{ .Subscription }}){{ end }}{{ end }}",
          "foreground": "#FFD700",
          "type": "az",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .Project }} \ud83c\udf10 {{ .Project }}{{ if .Account }} ({{ .Account }}){{ end }}{{ end }}",
          "foreground": "#FFD700",
          "type": "gcp",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_default": false
          },
          "template": "{{ if .Context }} \u2699\ufe0f {{ .Context }}{{ if .Namespace }}:{{ .Namespace }}{{ end }}{{ end }}",
          "foreground": "#66FF66",
          "type": "kubernetes",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .Context }} \ud83d\udc33 {{ .Context }}{{ end }}",
          "foreground": "#66FF66",
          "type": "docker",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "charged_icon": "\ud83d\udc8e",
            "charging_icon": "\u26a1",
            "discharging_icon": "\ud83d\udc32"
          },
          "template": "{{ if not .Error }}{{ .Icon }} {{ .Percentage }}{{ end }} ",
          "foreground": "#FFD700",
          "type": "battery",
          "style": "plain",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#66FF66{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FF6E3A{{end}}",
            "{{if eq \"Full\" .State.String}}#80FF80{{end}}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "{{ if gt .Code 0 }}\ud83d\udc80{{ else }}\ud83d\udd25{{ end }} ",
          "foreground": "#FF6E3A",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF4D6A{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "tooltips": [
    {
      "properties": {
        "fetch_status": false
      },
      "template": " \ud83d\udc32 {{ .HEAD }} ",
      "foreground": "#FFD700",
      "background": "#8B0000",
      "type": "git",
      "style": "diamond",
      "tips": [
        "git",
        "g"
      ]
    },
    {
      "template": " npm scripts ",
      "foreground": "#1A1A1A",
      "background": "#FFB347",
      "type": "npm",
      "style": "diamond",
      "tips": [
        "npm"
      ]
    },
    {
      "template": " cloud account ",
      "foreground": "#FFD700",
      "type": "aws",
      "style": "plain",
      "tips": [
        "aws",
        "az",
        "gcp"
      ]
    },
    {
      "template": " cluster context ",
      "foreground": "#66FF66",
      "type": "kubernetes",
      "style": "plain",
      "tips": [
        "kube",
        "docker"
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
