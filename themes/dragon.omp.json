{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "secondary_prompt": {
    "template": "\u2570\u2500🔥 ",
    "foreground": "#8B0000"
  },
  "transient_prompt": {
    "template": "🐉 🔥 ",
    "foreground": "#FF6E3A"
  },
  "console_title_template": "🐉 {{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "🐉",
          "foreground": "#FF6E3A",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_host": true
          },
          "leading_diamond": "\u256d\u2500",
          "template": " {{ if .SSHSession }}  {{ end }}{{ .UserName }}@{{ .HostName }} ",
          "foreground": "#FFD700",
          "background": "#8B0000",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "📁",
            "home_icon": "🏰",
            "style": "full"
          },
          "template": "  {{ .Path }} ",
          "foreground": "#1A1A1A",
          "background": "#FF8266",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "branch_icon": " ",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} 🔥 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} ✨ {{ .Staging.String }}{{ end }} ",
          "foreground": "#FFD700",
          "background": "#8A2BE2",
          "type": "git",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_virtual_env": true
          },
          "template": "  {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#FFD700",
          "type": "python",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "trailing_diamond": "\u2500\u256e",
          "template": "  {{ .Full }} ",
          "foreground": "#1A1A1A",
          "background": "#66FF66",
          "type": "node",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "style": "austin",
            "threshold": 500
          },
          "template": " \u23f1 \ufe0f {{ .FormattedMs }} ",
          "foreground": "#FFAB40",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \u23f0 {{ .CurrentDate | date \"15:04:05\" }} \u25aa CET {{ dateInZone \"15:04:05\" .CurrentDate \"Europe/Berlin\" }} ",
          "foreground": "#FFD700",
          "type": "time",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "charged_icon": "💎",
            "charging_icon": "⚡",
            "discharging_icon": "🐲"
          },
          "template": "{{ if not .Error }}{{ .Icon }} {{ .Percentage }}{{ end }} ",
          "foreground": "#FFD700",
          "type": "battery",
          "style": "plain",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#66FF66{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FF6E3A{{end}}",
            "{{if eq \"Full\" .State.String}}#80FF80{{end}}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "leading_diamond": "\u2570\u2500",
          "template": "{{ if gt .Code 0 }}💀{{ else }}🔥{{ end }} ",
          "foreground": "#FF6E3A",
          "background": "#8B0000",
          "type": "status",
          "style": "diamond",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF4D6A{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "tooltips": [
    {
      "properties": {
        "fetch_status": false
      },
      "template": " 🐉 {{ .HEAD }} ",
      "foreground": "#FFD700",
      "background": "#8B0000",
      "type": "git",
      "style": "diamond",
      "tips": [
        "git",
        "g"
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
